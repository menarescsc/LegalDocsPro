# ============================================================
# LegalDocsPro - Environment Variables
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Docker Compose will automatically load variables from .env
# ============================================================

# SQL Server SA password
# Requirements: at least 8 characters, containing uppercase, lowercase, digits, and symbols
MSSQL_SA_PASSWORD=YourStrong@Password123

# JWT signing secret
# Requirements: at least 32 characters, use a random string in production
JWT_SECRET=Your-Super-Secret-JWT-Key-At-Least-32-Characters-Long!
